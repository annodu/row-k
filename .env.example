EXA_API_KEY=your_exa_api_key_here
EXA_WEBSET_ID=
ADMIN_PASSWORD=change-me

# Google Places API (New) — used to detect Google review presence for salons
# not already covered by a verified booking platform. https://console.cloud.google.com
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# AnyAPI (https://getanyapi.com) — used by the admin Photo search tool to
# fetch candidate portfolio photos directly from a salon's own confirmed
# Instagram account, for salons the automated scrape+vision pipeline found
# none for. Pay-as-you-go USD wallet, ~100 free requests on signup, $2/1k
# requests after that. Grab a key from the AnyAPI dashboard.
ANYAPI_KEY=your_anyapi_key_here

# PostHog analytics (https://posthog.com) — free Cloud tier
# Client-side (exposed to the browser, must be prefixed VITE_)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Server-side only (used by /api/admin/dashboard to query the Stats/HogQL API) — keep secret
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
# Comma-separated public IP(s) to exclude from admin dashboard analytics (e.g. your home WiFi).
# Note: mobile carrier IPs rotate frequently, so this won't reliably catch phone traffic —
# use the ?rk_owner=1 opt-out link (see src/lib/analytics.ts) for those devices instead.
POSTHOG_INTERNAL_IPS=
